{
  "note": "FROZEN safety policy. Off limits to the experiment loop. A 'safe' map entry whose resolved path matches any pattern here (and no override) fails the checks gate.",
  "patterns": [
    "/documents/",
    "/desktop/",
    "/pictures/",
    "/downloads/",
    "/onedrive",
    "/login data",
    "/cookies",
    "/web data",
    "/local state",
    "/bookmarks",
    "/history",
    "/msg/attach",
    "/msg/file",
    "/msg/video",
    "/db_storage",
    "/msgattach",
    "/filestorage/(file|image|video|msgattach|emotion)",
    "/tdata/",
    "/.ssh",
    "/.gnupg",
    "/.aws",
    "/.kube",
    "/.config/gcloud",
    ".kdbx",
    "/wallet",
    "/credentials",
    "/sessions/",
    "/accounts/",
    "/windows/installer",
    "/package cache",
    "/winsxs",
    "/windows/system32",
    "pagefile.sys",
    "hiberfil.sys",
    "/.vscode/extensions",
    "/jetbrains/[^/]+/plugins",
    "/appdata/roaming/jetbrains",
    "/.android/avd",
    "/avd/",
    "/code/user",
    "/larkshell/aha/users",
    "/larkshell/iron/users",
    "/dingtalk/dbfiles",
    "/docker/wsl",
    "/localstate/ext4.vhdx",
    "/steam/userdata",
    "/saved games",
    "/telegram desktop/tdata",
    "/wechat files/[^/]+/filestorage/(file|image|video|msgattach|emotion)"
  ],
  "overrides": [
    "/xwechat_files/[^/]+/cache(/|$)",
    "/wechat files/[^/]+/filestorage/cache(/|$)"
  ],
  "user_content_ext": [
    ".doc",
    ".docx",
    ".xls",
    ".xlsx",
    ".ppt",
    ".pptx",
    ".pdf",
    ".rtf",
    ".db",
    ".sqlite",
    ".sqlite3",
    ".ldb",
    ".pst",
    ".ost",
    ".eml",
    ".key",
    ".pem",
    ".pfx",
    ".kdbx",
    ".wallet",
    ".ovpn"
  ],
  "max_user_content_ratio": 0.3,
  "min_fixture_f1": 0.9,
  "ref_measure_tolerance": 0.02,
  "min_evidence_chars": 6,
  "media_ext": [
    ".jpg",
    ".jpeg",
    ".png",
    ".gif",
    ".bmp",
    ".heic",
    ".mp4",
    ".mov",
    ".avi",
    ".mkv",
    ".mp3",
    ".wav",
    ".flac"
  ],
  "max_media_ratio": 0.85,
  "allowed_roots": [
    "%LOCALAPPDATA%",
    "%APPDATA%",
    "%TEMP%",
    "%USERPROFILE%/.cache",
    "%USERPROFILE%/.cargo",
    "%USERPROFILE%/.rustup",
    "%USERPROFILE%/.nuget",
    "%USERPROFILE%/.m2",
    "%USERPROFILE%/.gradle",
    "%USERPROFILE%/.ivy2",
    "%USERPROFILE%/.sbt",
    "%USERPROFILE%/.conda",
    "%USERPROFILE%/.android",
    "%USERPROFILE%/.platformio",
    "%USERPROFILE%/.codex",
    "%USERPROFILE%/.qoder",
    "%USERPROFILE%/.local",
    "%USERPROFILE%/.pi",
    "%USERPROFILE%/.minimax",
    "%USERPROFILE%/.cc-switch",
    "%USERPROFILE%/.vscode",
    "%USERPROFILE%/go",
    "%USERPROFILE%/scoop",
    "%USERPROFILE%/Documents/xwechat_files",
    "%USERPROFILE%/Documents/WeChat Files",
    "C:/Windows/Temp",
    "C:/Windows/SoftwareDistribution",
    "C:/Windows/Prefetch",
    "C:/Windows/LiveKernelReports",
    "C:/Windows/Minidump",
    "C:/Windows.old",
    "C:/Windows/ServiceProfiles",
    "C:/Windows/WinSxS",
    "C:/ProgramData",
    "%USERPROFILE%/.codegraph",
    "%USERPROFILE%/.aspire"
  ]
}
